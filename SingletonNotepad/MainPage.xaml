<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingletonNotepad.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingletonNotepad"
    xmlns:controls="using:SingletonNotepad.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- MenuBar -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Fichier">
                <MenuFlyoutItem Text="Ouvrir" Command="{x:Bind ViewModel.OpenCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Enregistrer" Command="{x:Bind ViewModel.SaveCommand}">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Copier tout" Command="{x:Bind ViewModel.CopyContentCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="Affichage">
                <MenuFlyoutItem Text="Recharger" Command="{x:Bind ViewModel.ReloadCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="Paramètres">
                <MenuFlyoutItem Text="Paramètres" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
            </MenuBarItem>
        </MenuBar>

        <!-- CommandBar -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <AppBarButton Icon="OpenFile" Label="Ouvrir" Command="{x:Bind ViewModel.OpenCommand}" />
            <AppBarButton Icon="Save" Label="Enregistrer" Command="{x:Bind ViewModel.SaveCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="Page2" Label="Normaliser" Command="{x:Bind ViewModel.NormalizeCommand}" />
            <AppBarButton Icon="Copy" Label="Copier" Command="{x:Bind ViewModel.CopyContentCommand}" />
            <AppBarSeparator />
            <AppBarToggleButton
                x:Name="SyntaxToggle"
                Icon="Font"
                Label="Couleur"
                IsChecked="{x:Bind ViewModel.IsSyntaxHighlightEnabled, Mode=TwoWay}"
                ToolTipService.ToolTip="Coloration syntaxique Markdown" />
        </CommandBar>

        <!-- Editor -->
        <Grid Grid.Row="2">
            <TextBox
                x:Name="EditorTextBox"
                Text="{x:Bind ViewModel.EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                FontFamily="Cascadia Mono, Consolas, monospace"
                FontSize="14"
                Padding="16"
                BorderThickness="0"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <!-- Markdown preview (visible when syntax highlight is on) -->
            <controls:MarkdownPreview
                x:Name="MarkdownPreviewControl"
                Text="{x:Bind ViewModel.EditorContent, Mode=OneWay}"
                Visibility="Collapsed" />
        </Grid>

        <!-- Diff Preview Overlay (hidden until normalize runs) -->
        <Border
            x:Name="DiffOverlay"
            Grid.Row="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="Collapsed">
            <controls:InlineDiffEditor x:Name="DiffViewer" />
        </Border>

        <!-- StatusBar -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="UTF-8"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2"
                           Text="{x:Bind ViewModel.SyncState, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="16,0" />
                <TextBlock Grid.Column="3"
                           Text="{x:Bind ViewModel.NormalizeStatus, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>
