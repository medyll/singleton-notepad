<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingletonNotepad.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingletonNotepad"
    xmlns:controls="using:SingletonNotepad.Views.Controls"
    xmlns:converters="using:SingletonNotepad.Views.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0">
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
                <AppBarButton Icon="Page2" Label="Normaliser" Command="{x:Bind ViewModel.NormalizeCommand}" />
                <AppBarButton Icon="SelectAll" Label="Tout sélect." Click="OnSelectAllClicked" />
                <AppBarButton Icon="Copy" Label="Copier" Command="{x:Bind ViewModel.CopyContentCommand}" />
                <AppBarButton Icon="Paste" Label="Coller" Click="OnPasteClicked" />
                <AppBarSeparator />
                <AppBarButton Label="Chat" Command="{x:Bind ChatViewModel.TogglePanelCommand}"
                              ToolTipService.ToolTip="Ouvrir le chat IA (Ctrl+Shift+C)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Mode Chat" Command="{x:Bind ChatViewModel.ToggleChatModeCommand}"
                              ToolTipService.ToolTip="Basculer mode chat (flottant/intégré)">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Background="Transparent" BorderThickness="0"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="Paramètres">
                <FontIcon Glyph="&#xE713;" FontSize="18" />
            </Button>
        </Grid>

        <!-- Editor area -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="250" />
            </Grid.RowDefinitions>

            <!-- External change notification banner -->
            <InfoBar
                x:Name="ExternalChangeBanner"
                Grid.Row="0"
                IsOpen="{x:Bind ViewModel.HasExternalChange, Mode=TwoWay}"
                Severity="Informational"
                Title="Fichier modifié"
                Message="Le fichier a été modifié par un autre programme."
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Recharger" Command="{x:Bind ViewModel.ReloadCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- WYSIWYG markdown editor (TipTap via WebView2) -->
            <WebView2
                x:Name="EditorWebView"
                Grid.Row="1"
                Loaded="OnEditorWebViewLoaded" />

            <!-- GridSplitter for resize -->
            <GridSplitter
                Grid.Row="2"
                Height="4"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- Split mode chat panel -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Chat IA" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Padding="0" Margin="0,0,4,0"
                            Command="{x:Bind ChatViewModel.ToggleChatModeCommand}"
                            ToolTipService.ToolTip="Changer mode (flottant/intégré)">
                        <FontIcon Glyph="&#xE943;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Width="32" Height="32" Padding="0"
                            Command="{x:Bind ChatViewModel.TogglePanelCommand}"
                            ToolTipService.ToolTip="Réduire">
                        <FontIcon Glyph="&#xE921;" FontSize="12" />
                    </Button>
                </Grid>
                
                <!-- Messages -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <ItemsControl ItemsSource="{x:Bind ChatViewModel.Messages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock FontWeight="SemiBold" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding Role}" />
                                        <Run Text=" —" />
                                        <Run Text="{Binding Timestamp}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               FontSize="13" Margin="4,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Input -->
                <Grid Grid.Row="2" Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{x:Bind ChatViewModel.UserInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Demander à l'IA... (Ctrl+Entrée pour envoyer)"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="48"
                             MaxHeight="150" />
                    <Button Grid.Column="1" Margin="4,0,0,0"
                            Command="{x:Bind ChatViewModel.ClearChatCommand}"
                            ToolTipService.ToolTip="Effacer le chat">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2" Margin="4,0,0,0"
                            Command="{x:Bind ChatViewModel.SendCommand}"
                            Style="{ThemeResource AccentButtonStyle}">
                        <FontIcon Glyph="&#xE724;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- StatusBar -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="UTF-8"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.SpellCheckLang, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind ViewModel.SpellCheckLang, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                           Margin="12,0" />
                <TextBlock Grid.Column="3"
                           Text="{x:Bind ViewModel.SyncState, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="16,0" />
                <TextBlock Grid.Column="4"
                           Text="{x:Bind ViewModel.NormalizeStatus, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- Chat Bubble Overlay (added programmatically) -->
    </Grid>
</Page>
