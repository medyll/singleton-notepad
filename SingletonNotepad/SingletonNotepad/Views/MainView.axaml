<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SingletonNotepad.ViewModels"
             x:Class="SingletonNotepad.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- MenuBar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Édition">
                <MenuItem Header="Rechercher" InputGesture="Ctrl+F"/>
                <MenuItem Header="Remplacer" InputGesture="Ctrl+H"/>
            </MenuItem>
            <MenuItem Header="_Affichage">
                <MenuItem Header="Zoom"/>
                <MenuItem Header="Plein écran"/>
            </MenuItem>
            <MenuItem Header="_Paramètres">
                <MenuItem Header="Paramètres" Click="OnSettingsClick" InputGesture="Ctrl+,">
                    <MenuItem.Icon>
                        <PathIcon Data="M19.14,12.94C19.16,12.78 19.16,12.61 19.16,12.43C19.16,12.25 19.16,12.09 19.14,11.93L21.41,10.16C21.61,10 21.66,9.71 21.5,9.5L19.34,5.77C19.18,5.5 18.88,5.44 18.64,5.55L15.95,6.63C15.38,6.19 14.76,5.83 14.1,5.56L13.7,2.69C13.66,2.38 13.4,2.14 13.08,2.14H8.79C8.47,2.14 8.21,2.38 8.17,2.69L7.77,5.56C7.11,5.83 6.49,6.19 5.92,6.63L3.23,5.55C2.99,5.44 2.69,5.5 2.53,5.77L0.37,9.5C0.21,9.71 0.26,10 0.46,10.16L2.73,11.93C2.71,12.09 2.71,12.25 2.71,12.43C2.71,12.61 2.71,12.78 2.73,12.94L0.46,14.71C0.26,14.87 0.21,15.16 0.37,15.37L2.53,19.1C2.69,19.37 2.99,19.43 3.23,19.32L5.92,18.24C6.49,18.68 7.11,19.04 7.77,19.31L8.17,22.18C8.21,22.49 8.47,22.73 8.79,22.73H13.08C13.4,22.73 13.66,22.49 13.7,22.18L14.1,19.31C14.76,19.04 15.38,18.68 15.95,18.24L18.64,19.32C18.88,19.43 19.18,19.37 19.34,19.1L21.5,15.37C21.66,15.16 21.61,14.87 21.41,14.71L19.14,12.94M11.93,15.5C10.22,15.5 8.83,14.11 8.83,12.4C8.83,10.69 10.22,9.3 11.93,9.3C13.64,9.3 15.03,10.69 15.03,12.4C15.03,14.11 13.64,15.5 11.93,15.5Z"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- CommandBar + Editor -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,8">
                <Button Command="{Binding LoadFileCommand}" Margin="4,0" ToolTip.Tip="Ouvrir">
                    <PathIcon Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z"/>
                </Button>
                <Button Command="{Binding SaveFileCommand}" Margin="4,0" ToolTip.Tip="Enregistrer">
                    <PathIcon Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
                </Button>
                <Separator Margin="8,0"/>
                <Button Command="{Binding NormalizeCommand}" Margin="4,0" ToolTip.Tip="Normaliser">
                    <PathIcon Data="M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8Z"/>
                </Button>
                <Button Margin="4,0" ToolTip.Tip="Copier">
                    <PathIcon Data="M19,21H8V7H19M19,4H8A2,2 0 0,0 6,6V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V6A2,2 0 0,0 19,4M16,6H14V14H16"/>
                </Button>
            </StackPanel>

            <TextBox
                Grid.Row="1"
                Text="{Binding EditorContent, Mode=TwoWay}"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                FontFamily="Consolas"
                FontSize="14"
                Padding="16"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="8,4" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <PathIcon Data="M19,19H5V5H19M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M13.96,12.29L11.21,15.83L9.25,13.47L6.5,17H17.5L13.96,12.29Z"/>
                    <TextBlock Text="UTF-8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <PathIcon Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19M9,10V12H7V10H9M11.5,10V12H9.5V10H11.5M14,10V12H12V10H14M16.5,10V12H14.5V10H16.5M9,13V15H7V13H9M11.5,13V15H9.5V13H11.5M14,13V15H12V13H14M16.5,13V15H14.5V13H16.5Z"/>
                    <TextBlock x:Name="LineColText" Text="Ln 1, Col 1" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
