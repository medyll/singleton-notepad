<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SingletonNotepad.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SingletonNotepad.Views"
    xmlns:viewmodels="using:SingletonNotepad.ViewModels"
    xmlns:models="using:SingletonNotepad.Core.Models">

    <Grid RowDefinitions="Auto,*">
        <!-- Navigation Bar -->
        <CommandBar Grid.Row="0">
            <AppBarButton 
                Icon="Back" 
                Label="Retour" 
                Command="{x:Bind ViewModel.GoBackCommand}"/>
            <AppBarSeparator/>
            <AppBarButton 
                Icon="Save" 
                Label="Enregistrer" 
                Command="{x:Bind ViewModel.SaveSettingsCommand}"/>
            <AppBarButton 
                Icon="Refresh" 
                Label="Rétablir" 
                Command="{x:Bind ViewModel.ResetToDefaultsCommand}"/>
        </CommandBar>

        <!-- Settings Content -->
        <NavigationView
            x:Name="SettingsNavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="OnNavigationViewSelectionChanged">
            
            <NavigationView.MenuItems>
                <NavigationViewItem 
                    Icon="Brush" 
                    Content="Apparence" 
                    Tag="Apparence"/>
                <NavigationViewItem 
                    Icon="Document" 
                    Content="Fichiers" 
                    Tag="Fichiers"/>
            </NavigationView.MenuItems>

            <Frame x:Name="SettingsContentFrame"/>
        </NavigationView>
    </Grid>
</UserControl>
