<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SingletonNotepad.Views.Controls.InlineDiffEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Aperçu des modifications" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="AddedCount" Foreground="#107C10" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="DeletedCount" Foreground="#D13438" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Name="ModifiedCount" Foreground="#FF8C00" Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Diff Content -->
        <ScrollViewer Grid.Row="1" x:Name="DiffScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DiffItems" HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding LineNumber}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" TextAlignment="Right" Padding="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Content="Annuler" Click="OnCancelClicked" />
                <Button x:Name="ApplyButton" Content="Appliquer" Style="{ThemeResource AccentButtonStyle}" Click="OnApplyClicked" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
