<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SingletonNotepad.Views.Controls.ChatBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SingletonNotepad.Views.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <Style x:Key="ChatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Minimized state: floating icon -->
        <Button
            x:Name="MinimizedButton"
            Width="44" Height="44" CornerRadius="22"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,16,16"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            Click="OnMinimizedClicked"
            ToolTipService.ToolTip="Chat IA">
            <FontIcon Glyph="&#xE8BD;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Button>

        <!-- Expanded state: chat panel -->
        <Border
            x:Name="ChatPanel"
            Width="380" Height="480"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,16,16"
            Style="{StaticResource ChatCard}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Assistant IA" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="32" Height="32" Padding="0" Click="OnMinimizeClicked"
                            ToolTipService.ToolTip="Minimiser">
                        <FontIcon Glyph="&#xE921;" FontSize="12" />
                    </Button>
                    <Button Grid.Column="2" Width="32" Height="32" Padding="0" Click="OnCloseClicked"
                            ToolTipService.ToolTip="Fermer">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- Message history -->
                <ScrollViewer Grid.Row="1" x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"
                              Padding="12,8" BorderThickness="0,0,0,1"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ItemsControl x:Name="MessageList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock FontWeight="SemiBold" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding Role}" />
                                        <Run Text=" —" />
                                        <Run Text="{Binding Timestamp}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               FontSize="13" Margin="4,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Input area -->
                <Grid Grid.Row="2" Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             PlaceholderText="Demander à l'IA..."
                             AcceptsReturn="False"
                             KeyDown="OnInputKeyDown" />
                    <Button Grid.Column="1" Margin="4,0,0,0"
                            Click="OnClearClicked"
                            ToolTipService.ToolTip="Effacer le chat">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2" Margin="4,0,0,0"
                            Click="OnSendClicked"
                            Style="{ThemeResource AccentButtonStyle}">
                        <FontIcon Glyph="&#xE724;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
