<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SingletonNotepad.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SingletonNotepad.Views"
    xmlns:converters="using:SingletonNotepad.Views.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter" />
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="4,20,0,6" />
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="0" Padding="24,16,24,32">

            <!-- Title -->
            <TextBlock Text="Paramètres" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <!-- ══ APPARENCE ══ -->
            <TextBlock Text="Apparence" Style="{StaticResource GroupHeaderStyle}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <!-- Thème -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Thème d'application" />
                            <TextBlock Text="Clair, sombre ou thème système"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="160"
                                  SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}">
                            <x:String>System</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                    <!-- Toujours en bas -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE74B;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Démarrer en bas de l'écran" />
                            <TextBlock Text="Positionne la fenêtre en bas au démarrage"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.AlwaysStartAtBottom, Mode=TwoWay}"
                                      OnContent="" OffContent="" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                    <!-- Toujours visible -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8CB;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Toujours au premier plan" />
                            <TextBlock Text="Fenêtre toujours visible par-dessus les autres"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}"
                                      OnContent="" OffContent="" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ FICHIERS ══ -->
            <TextBlock Text="Fichiers" Style="{StaticResource GroupHeaderStyle}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>

                    <!-- Fichier de notes -->
                    <StackPanel Padding="16,14" Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="18"
                                      VerticalAlignment="Center" Margin="0,0,16,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Fichier de notes" />
                                <TextBlock Text="Chemin vers MY_SINGLETON_NOTEPAD.md"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBox
                            Text="{x:Bind ViewModel.NotesFilePath, Mode=TwoWay}"
                            PlaceholderText="C:\Users\...\MY_SINGLETON_NOTEPAD.md"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                    <!-- Enregistrement auto -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE74E;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Enregistrement automatique" />
                            <TextBlock Text="Sauvegarde 2 secondes après la dernière frappe"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.AutoSave, Mode=TwoWay}"
                                      OnContent="" OffContent="" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                    <!-- Délai auto-save -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Délai auto-save (ms)" />
                            <TextBlock Text="Entre 500 et 10 000 ms"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <NumberBox Grid.Column="2" VerticalAlignment="Center"
                                   Value="{x:Bind ViewModel.AutoSaveDelayMs, Mode=TwoWay}"
                                   Minimum="500" Maximum="10000"
                                   SpinButtonPlacementMode="Inline" MinWidth="140" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ══ NORMALISATION ══ -->
            <TextBlock Text="Normalisation LLM" Style="{StaticResource GroupHeaderStyle}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>

                    <!-- Normaliser à la fermeture -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Normaliser à la fermeture" />
                            <TextBlock Text="Lance le LLM avant de quitter l'application"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.AutoNormalizeOnClose, Mode=TwoWay}"
                                      OnContent="" OffContent="" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                    <!-- Délai inactivité -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Délai d'inactivité (minutes)" />
                            <TextBlock Text="Déclenche la normalisation automatique après N minutes"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <NumberBox Grid.Column="2" VerticalAlignment="Center"
                                   Value="{x:Bind ViewModel.IdleMinutesBeforeNormalize, Mode=TwoWay}"
                                   Minimum="1" Maximum="120"
                                   SpinButtonPlacementMode="Inline" MinWidth="140" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ══ FOURNISSEUR LLM ══ -->
            <TextBlock Text="Fournisseur LLM" Style="{StaticResource GroupHeaderStyle}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>

                    <!-- Sélection provider actif -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9CE;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Fournisseur actif" FontWeight="SemiBold" />
                            <TextBlock Text="LLM utilisé pour la normalisation"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="160"
                                  ItemsSource="{x:Bind ViewModel.AvailableProviders, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.LlmProvider, Mode=TwoWay}" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                    <!-- ── Ollama ── -->
                    <TextBlock Text="Ollama (local)" Margin="16,12,16,4"
                               Visibility="{x:Bind ViewModel.OllamaSectionVisibility, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />

                    <Grid Padding="16,8,16,8" MinHeight="52"
                          Visibility="{x:Bind ViewModel.OllamaSectionVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Endpoint" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.OllamaEndpoint, Mode=TwoWay}"
                                 PlaceholderText="http://localhost:11434" />
                    </Grid>

                    <Grid Padding="16,4,16,12" MinHeight="52"
                          Visibility="{x:Bind ViewModel.OllamaSectionVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Modèle" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.OllamaModel, Mode=TwoWay}"
                                  IsEditable="True"
                                  PlaceholderText="Sélectionner ou saisir un modèle" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.RefreshModelsCommand}"
                                ToolTipService.ToolTip="Actualiser les modèles">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <InfoBar Margin="16,0,16,8"
                             Visibility="{x:Bind ViewModel.OllamaSectionVisibility, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.IsLoadingModels, Mode=OneWay}"
                             IsClosable="False" Severity="Informational"
                             Title="Chargement des modèles..." />

                    <InfoBar Margin="16,0,16,8"
                             Visibility="{x:Bind ViewModel.OllamaSectionVisibility, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.ModelFetchError, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                             IsClosable="True" Severity="Warning"
                             Title="{x:Bind ViewModel.ModelFetchError, Mode=OneWay}" />

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0"
                               Visibility="{x:Bind ViewModel.OpenAiSectionVisibility, Mode=OneWay}" />

                    <!-- ── OpenAI ── -->
                    <TextBlock Text="OpenAI" Margin="16,12,16,4"
                               Visibility="{x:Bind ViewModel.OpenAiSectionVisibility, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />

                    <Grid Padding="16,4,16,4" MinHeight="52"
                          Visibility="{x:Bind ViewModel.OpenAiSectionVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Modèle" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.OpenAiModel, Mode=TwoWay}"
                                  IsEditable="True"
                                  PlaceholderText="Sélectionner ou saisir un modèle" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.RefreshModelsCommand}"
                                ToolTipService.ToolTip="Actualiser les modèles">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <InfoBar Margin="16,0,16,8"
                             Visibility="{x:Bind ViewModel.OpenAiSectionVisibility, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.IsLoadingModels, Mode=OneWay}"
                             IsClosable="False" Severity="Informational"
                             Title="Chargement des modèles..." />

                    <InfoBar Margin="16,0,16,8"
                             Visibility="{x:Bind ViewModel.OpenAiSectionVisibility, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.ModelFetchError, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                             IsClosable="True" Severity="Warning"
                             Title="{x:Bind ViewModel.ModelFetchError, Mode=OneWay}" />

                    <Grid Padding="16,4,16,12" MinHeight="52"
                          Visibility="{x:Bind ViewModel.OpenAiSectionVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Clé API" VerticalAlignment="Center" />
                        <PasswordBox Grid.Column="1"
                                     Password="{x:Bind ViewModel.OpenAiApiKey, Mode=TwoWay}"
                                     PlaceholderText="sk-..." />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0"
                               Visibility="{x:Bind ViewModel.AnthropicSectionVisibility, Mode=OneWay}" />

                    <!-- ── Anthropic ── -->
                    <TextBlock Text="Anthropic" Margin="16,12,16,4"
                               Visibility="{x:Bind ViewModel.AnthropicSectionVisibility, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />

                    <Grid Padding="16,4,16,4" MinHeight="52"
                          Visibility="{x:Bind ViewModel.AnthropicSectionVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Modèle" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.AnthropicModel, Mode=TwoWay}"
                                  PlaceholderText="Sélectionner un modèle" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.RefreshModelsCommand}"
                                ToolTipService.ToolTip="Actualiser les modèles">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Grid Padding="16,4,16,12" MinHeight="52"
                          Visibility="{x:Bind ViewModel.AnthropicSectionVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Clé API" VerticalAlignment="Center" />
                        <PasswordBox Grid.Column="1"
                                     Password="{x:Bind ViewModel.AnthropicApiKey, Mode=TwoWay}"
                                     PlaceholderText="sk-ant-..." />
                    </Grid>

                    <!-- ── Fournisseur détecté (Mistral, Groq, etc.) ── -->
                    <TextBlock Margin="16,12,16,4"
                               Visibility="{x:Bind ViewModel.CustomProviderSectionVisibility, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold"
                               Text="{x:Bind ViewModel.LlmProvider, Mode=OneWay}" />

                    <Grid Padding="16,4,16,4" MinHeight="52"
                          Visibility="{x:Bind ViewModel.CustomProviderSectionVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Modèle" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.CustomProviderModel, Mode=TwoWay}"
                                  IsEditable="True"
                                  PlaceholderText="Sélectionner ou saisir un modèle" />
                        <Button Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.RefreshModelsCommand}"
                                ToolTipService.ToolTip="Actualiser les modèles">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <InfoBar Margin="16,0,16,8"
                             Visibility="{x:Bind ViewModel.CustomProviderSectionVisibility, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.IsLoadingModels, Mode=OneWay}"
                             IsClosable="False" Severity="Informational"
                             Title="Chargement des modèles..." />

                    <InfoBar Margin="16,0,16,8"
                             Visibility="{x:Bind ViewModel.CustomProviderSectionVisibility, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.ModelFetchError, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                             IsClosable="True" Severity="Warning"
                             Title="{x:Bind ViewModel.ModelFetchError, Mode=OneWay}" />

                    <InfoBar Margin="16,0,16,12"
                             Visibility="{x:Bind ViewModel.CustomProviderSectionVisibility, Mode=OneWay}"
                             IsOpen="True" IsClosable="False" Severity="Success"
                             Title="Clé détectée depuis les variables d'environnement"
                             Message="Aucune saisie de clé requise." />

                    <InfoBar Margin="16,0,16,12"
                             IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Clés chiffrées avec DPAPI"
                             Message="Seul votre compte Windows peut déchiffrer ces clés."
                             Visibility="{x:Bind ViewModel.OpenAiSectionVisibility, Mode=OneWay}" />
                    <InfoBar Margin="16,0,16,12"
                             IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Clés chiffrées avec DPAPI"
                             Message="Seul votre compte Windows peut déchiffrer ces clés."
                             Visibility="{x:Bind ViewModel.AnthropicSectionVisibility, Mode=OneWay}" />

                </StackPanel>
            </Border>

            <!-- ══ ÉDITEUR ══ -->
            <TextBlock Text="Éditeur" Style="{StaticResource GroupHeaderStyle}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>

                    <!-- Correcteur orthographique -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8D1;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Correcteur orthographique" />
                            <TextBlock Text="Souligne les erreurs en temps réel"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                      IsOn="{x:Bind ViewModel.SpellCheckEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                    <!-- Langue du correcteur -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xF2B7;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Langue du correcteur" />
                            <TextBlock Text="Auto-détection, Français ou Anglais"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="160"
                                  SelectedValue="{x:Bind ViewModel.SpellCheckLanguage, Mode=TwoWay}">
                            <x:String>auto</x:String>
                            <x:String>fr-FR</x:String>
                            <x:String>en-US</x:String>
                        </ComboBox>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ══ CHAT IA ══ -->
            <TextBlock Text="Chat IA" Style="{StaticResource GroupHeaderStyle}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Fournisseur du chat" />
                            <TextBlock Text="Indépendant du fournisseur de normalisation"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="160"
                                  ItemsSource="{x:Bind ViewModel.AvailableProviders, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.ChatLlmProvider, Mode=TwoWay}"
                                  PlaceholderText="Même que normalisation" />
                        <Button Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.ResetChatProviderCommand}"
                                ToolTipService.ToolTip="Réinitialiser (utiliser le même fournisseur que la normalisation)">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ RÈGLES ══ -->
            <TextBlock Text="Règles de normalisation" Style="{StaticResource GroupHeaderStyle}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel Padding="16,14" Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE292;" FontSize="18"
                                  VerticalAlignment="Top" Margin="0,2,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="Instructions envoyées au LLM (AGENTS.md)" />
                            <TextBox
                                Text="{x:Bind ViewModel.RulesContent, Mode=TwoWay}"
                                AcceptsReturn="True" TextWrapping="Wrap"
                                FontFamily="Cascadia Mono, Consolas, monospace"
                                FontSize="13" MinHeight="180"
                                HorizontalAlignment="Stretch" />
                            <Button Content="Enregistrer les règles" Click="OnSaveRules" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ SAUVEGARDES ══ -->
            <TextBlock Text="Sauvegardes" Style="{StaticResource GroupHeaderStyle}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>

                    <!-- Nombre max -->
                    <Grid Padding="16,14" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="18"
                                  VerticalAlignment="Center" Margin="0,0,16,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="Nombre maximum de sauvegardes" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="2" VerticalAlignment="Center"
                                   Value="{x:Bind ViewModel.MaxBackupCount, Mode=TwoWay}"
                                   Minimum="3" Maximum="100"
                                   SpinButtonPlacementMode="Inline" MinWidth="120" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="16,0" />

                    <!-- Liste -->
                    <StackPanel Padding="16,12" Spacing="8">
                        <ListView
                            ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}"
                            SelectionMode="None" MinHeight="40">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding VersionDisplay}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TimestampDisplay}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="Restaurer"
                                                Tag="{Binding Path}" Click="OnRestoreBackup" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="Actualiser" Click="OnRefreshBackups" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
